# Copy this file to .env and fill in your Supabase project credentials.
# Never commit .env to version control.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Optional — error monitoring. Leave unset to disable (no-op); errors just log
# to the console as before. Get a DSN from sentry.io → your project → Settings.
VITE_SENTRY_DSN=

# Optional — WeChat Official Account login (only appears inside WeChat's
# in-app browser). The AppID is public (it's embedded in the OAuth redirect
# URL client-side); the AppSecret is NOT — that lives only as a Supabase
# Edge Function secret (WECHAT_APPSECRET), never in this file or the client.
VITE_WECHAT_APPID=

# Optional — order-confirmation and order-shipped SMS via Twilio. None of
# these belong in this file or the client: they're Supabase Edge Function
# secrets only (stripe-webhook and notify-shipped read them via Deno.env.get).
# Leave unset to disable (no-op) — get an Account SID/Auth Token from the
# Twilio Console and a Twilio phone number that can send SMS.
#   TWILIO_ACCOUNT_SID=
#   TWILIO_AUTH_TOKEN=
#   TWILIO_FROM_NUMBER=
