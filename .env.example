# Copy this file to .env and fill in your Supabase project credentials.
# Never commit .env to version control.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Optional — error monitoring. Leave unset to disable (no-op); errors just log
# to the console as before. Get a DSN from sentry.io → your project → Settings.
VITE_SENTRY_DSN=
